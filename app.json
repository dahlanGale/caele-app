{
  "expo": {
    "name": "caele-app",
    "slug": "caele-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "caeleapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ]
    ],
    "extra": {
      "firebase": {
        "apiKey": "AIzaSyDwm6aQ-I--4O2qJq3DrWPMaXlHH7P8k4A",
        "authDomain": "caele-app.firebaseapp.com",
        "projectId": "caele-app",
        "storageBucket": "caele-app.firebasestorage.app",
        "messagingSenderId": "54754152307",
        "appId": "1:54754152307:web:f679ed5fb2932430caff06",
        "measurementId": "G-R1E9BXXWF1"
      },
      "google": {
        "expoClientId": "",
        "iosClientId": "",
        "androidClientId": "",
        "webClientId": ""
      }
    },
    "experiments": {
      "typedRoutes": true
    }
  }
}
