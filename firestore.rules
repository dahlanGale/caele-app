rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Cada PYME (y todo lo que contiene) pertenece exclusivamente al usuario cuyo UID coincide con el pymeId.
    match /pymes/{pymeId} {
      allow read, write: if request.auth != null && request.auth.uid == pymeId;

      match /{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == pymeId;
      }
    }

    // Colección legacy de usuarios (también aislada por UID).
    match /usuarios/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
