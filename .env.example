# Configuración de Firebase (también en app.json > extra > firebase)
# En web estas claves son públicas; se centralizan aquí para evitar hardcodearlas.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=

# Credenciales de Google OAuth (para login nativo y web)
# Obtenerlas en https://console.cloud.google.com/apis/credentials
GOOGLE_EXPO_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=
GOOGLE_WEB_CLIENT_ID=
